@model IReadOnlyList<QuanLySieuThi.Models.Entities.AuditLog>
@{
    ViewData["Title"] = "Nhật ký thao tác";
    var actions = (IReadOnlyDictionary<string, string>)ViewBag.Actions;
}
<div class="page-heading">
    <div><p class="eyebrow">QUẢN TRỊ</p><h1>Nhật ký thao tác</h1><p class="text-muted">Tra cứu ai đã thay đổi dữ liệu quan trọng và thời điểm thực hiện.</p></div>
</div>
<form method="get" class="row g-3 align-items-end mb-4">
    <label class="col-sm-6 col-md-2">Từ ngày<input type="date" name="from" value="@ViewBag.From" class="form-control" /></label>
    <label class="col-sm-6 col-md-2">Đến ngày<input type="date" name="to" value="@ViewBag.To" class="form-control" /></label>
    <label class="col-sm-6 col-md-3">Loại thao tác
        <select name="action" class="form-select">
            <option value="">Tất cả thao tác</option>
            @foreach (var item in actions)
            {
                <option value="@item.Key" selected="@(item.Key == (string?)ViewBag.Action)">@item.Value</option>
            }
        </select>
    </label>
    <label class="col-sm-6 col-md-3">Tìm kiếm<input name="search" value="@ViewBag.Search" class="form-control" placeholder="Người dùng, sản phẩm, hóa đơn…" /></label>
    <div class="col-md-2"><button class="btn btn-primary w-100" type="submit">Lọc nhật ký</button></div>
</form>
<p class="text-muted">Có @ViewBag.TotalCount bản ghi · Trang @ViewBag.Page/@ViewBag.PageCount · Giờ hiển thị UTC+7</p>
<div class="table-responsive panel table-panel">
    <table class="table align-middle mb-0">
        <thead><tr><th>Thời gian</th><th>Người thực hiện</th><th>Thao tác</th><th>Đối tượng</th><th>Chi tiết thay đổi</th></tr></thead>
        <tbody>
        @if (Model.Count == 0)
        {
            <tr><td colspan="5" class="text-center text-muted py-4">Không có thao tác trong khoảng đã chọn.</td></tr>
        }
        @foreach (var log in Model)
        {
            <tr>
                <td class="text-nowrap">@DateTime.SpecifyKind(log.CreatedAt, DateTimeKind.Utc).AddHours(7).ToString("dd/MM/yyyy HH:mm:ss")</td>
                <td><strong>@log.ActorUsername</strong></td>
                <td>@(actions.TryGetValue(log.ActionType, out var label) ? label : log.ActionType)</td>
                <td>@log.TargetName <small class="d-block text-muted">@log.TargetType · @log.TargetId</small></td>
                <td>@log.Details</td>
            </tr>
        }
        </tbody>
    </table>
</div>
@if ((int)ViewBag.PageCount > 1)
{
    <nav aria-label="Phân trang nhật ký" class="mt-3">
        <ul class="pagination">
            @for (var number = Math.Max(1, (int)ViewBag.Page - 2); number <= Math.Min((int)ViewBag.PageCount, (int)ViewBag.Page + 2); number++)
            {
                <li class="page-item @(number == (int)ViewBag.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-from="@ViewBag.From" asp-route-to="@ViewBag.To" asp-route-action="@ViewBag.Action" asp-route-search="@ViewBag.Search" asp-route-page="@number">@number</a>
                </li>
            }
        </ul>
    </nav>
}
